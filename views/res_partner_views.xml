<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Global extension: available on every contact form.
        Adds the Manpower Provider flag and, for flagged partners,
        an Agreements smart button next to the standard ones.
    -->
    <record id="res_partner_view_form_manpower" model="ir.ui.view">
        <field name="name">res.partner.form.manpower</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_manpower_agreements" type="object"
                        class="oe_stat_button" icon="fa-handshake-o"
                        invisible="not is_manpower_provider">
                    <field name="manpower_agreement_count" widget="statinfo" string="Agreements"/>
                </button>
            </div>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="is_manpower_provider"/>
            </xpath>
        </field>
    </record>

    <!--
        Dedicated standalone form used only by the Service Providers action.
        It does not inherit base.view_partner_form, so fields, tabs and smart
        buttons added by other modules (hotel, EIMS, visits, etc.) do not
        appear on this form.
    -->
    <record id="manpower_provider_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.manpower.provider</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" eval="False"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Service Provider">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_manpower_agreements" type="object"
                                class="oe_stat_button" icon="fa-handshake-o">
                            <field name="manpower_agreement_count" widget="statinfo" string="Agreements"/>
                        </button>
                    </div>
                    <field name="active" invisible="1"/>
                    <field name="is_company" invisible="1"/>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title mb24">
                        <field name="company_type" widget="radio"
                               options="{'horizontal': true}"/>
                        <h1>
                            <field name="name" placeholder="Provider Name..."
                                   default_focus="1" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Company Information">
                            <field name="is_manpower_provider"/>
                            <field name="vat" placeholder="VAT / TIN"/>
                            <field name="website" widget="url" placeholder="https://..."/>
                            <field name="category_id" widget="many2many_tags"
                                   options="{'color_field': 'color'}"
                                   placeholder="e.g. Manpower, Cleaning, Security..."/>
                        </group>
                        <group string="Active Manpower Summary" invisible="not is_manpower_provider">
                            <label for="active_male_qty" string="Workers Under Active Agreements"/>
                            <div>
                                <div>
                                    <strong>Male: </strong>
                                    <field name="active_male_qty" class="oe_inline" readonly="1"/>
                                </div>
                                <div>
                                    <strong>Female: </strong>
                                    <field name="active_female_qty" class="oe_inline" readonly="1"/>
                                </div>
                                <div>
                                    <strong>Total: </strong>
                                    <field name="active_manpower_qty" class="oe_inline" readonly="1"/>
                                </div>
                            </div>
                        </group>
                        <group string="Contact">
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="email" widget="email"
                                   context="{'gravatar_image': True}"/>
                            <field name="function" invisible="is_company"/>
                            <field name="title" options="{'no_open': True}"
                                   invisible="is_company"/>
                        </group>
                    </group>
                    <group string="Address">
                        <group>
                            <field name="street" placeholder="Street..."/>
                            <field name="street2" placeholder="Street 2..."/>
                            <field name="city" placeholder="City"/>
                        </group>
                        <group>
                            <field name="state_id"
                                   options="{'no_open': True, 'no_quick_create': True}"
                                   context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                            <field name="zip" placeholder="ZIP"/>
                            <field name="country_id"
                                   options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contact Persons" name="contact_persons">
                            <field name="child_ids"
                                   context="{'default_parent_id': id, 'default_type': 'contact'}">
                                <list editable="bottom">
                                    <field name="type" required="1"/>
                                    <field name="name" required="1"/>
                                    <field name="function" invisible="type != 'contact'"/>
                                    <field name="email" widget="email"/>
                                    <field name="phone" widget="phone"/>
                                    <field name="mobile" widget="phone"/>
                                </list>
                            </field>
                        </page>
                        <page string="Internal Notes" name="internal_notes">
                            <field name="comment" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_manpower_provider" model="ir.actions.act_window">
        <field name="name">Manpower Providers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_manpower_provider', '=', True)]</field>
        <field name="context">{'default_is_manpower_provider': True, 'default_company_type': 'company'}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'sequence': 1}),
            (0, 0, {'view_mode': 'list', 'sequence': 2}),
            (0, 0, {'view_mode': 'form', 'sequence': 3, 'view_id': ref('manpower_provider_view_form')}),
        ]"/>
    </record>
</odoo>
