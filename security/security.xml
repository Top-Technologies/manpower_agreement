<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_manpower" model="ir.module.category">
        <field name="name">Manpower Agreements</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_manpower_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_manpower"/>
    </record>

    <record id="group_manpower_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_manpower"/>
        <field name="implied_ids" eval="[(4, ref('group_manpower_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
